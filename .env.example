# Instagram Credentials
IG_USERNAME=your_account_username
IG_PASSWORD=your_secure_password

# Proxy (optional but recommended)
# Format: http://user:pass@host:port or socks5://user:pass@host:port
PROXY_URL=

# 2FA Fallback (set to 'prompt' for CLI input, or provide a TOTP seed if supported)
TWO_FA_MODE=prompt

# Environment
LOG_LEVEL=INFO
SESSION_DIR=sessions
MEDIA_DIR=media
